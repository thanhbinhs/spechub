model users {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(200)
  email_verified_at DateTime?
  password_hash     String?
  username          String?   @unique @db.VarChar(60)
  display_name      String?   @db.VarChar(120)
  avatar_url        String?
  role              String    @default("reader") @db.VarChar(30)
  is_active         Boolean   @default(true)
  last_login_at     DateTime?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)

  wiki_revisions wiki_revisions[]
  comments       comments[]
  search_logs    search_logs[]
  wishlists      wishlists[]
  price_alerts   price_alerts[]
  notifications  notifications[]
  subscription   subscriptions?

  @@index([email])
  @@index([username])
  @@map("users")
}

model wiki_articles {
  id                  String    @id @default(uuid()) @db.Uuid
  entity_table        String    @db.VarChar(80)
  entity_id           String    @db.VarChar(64)
  language_id         Int
  title               String    @db.VarChar(300)
  slug                String    @db.VarChar(320)
  summary             String?
  body_markdown       String?
  body_html           String?
  status              String    @default("draft") @db.VarChar(20)
  current_revision_id String?   @db.Uuid
  view_count          BigInt    @default(0)
  published_at        DateTime?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime? @db.Timestamptz(6)

  language languages @relation(fields: [language_id], references: [id])

  revisions wiki_revisions[]
  citations wiki_article_citations[]

  @@unique([entity_table, entity_id, language_id])
  @@unique([slug, language_id])
  @@index([status])
  @@map("wiki_articles")
}

model wiki_revisions {
  id              String    @id @default(uuid()) @db.Uuid
  article_id      String    @db.Uuid
  author_user_id  String?   @db.Uuid
  revision_number Int
  title           String?   @db.VarChar(300)
  body_markdown   String?
  change_summary  String?   @db.VarChar(300)
  is_published    Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  article wiki_articles @relation(fields: [article_id], references: [id])
  author  users?        @relation(fields: [author_user_id], references: [id])

  @@unique([article_id, revision_number])
  @@map("wiki_revisions")
}

model wiki_article_citations {
  id          String  @id @default(uuid()) @db.Uuid
  article_id  String  @db.Uuid
  citation_id String  @db.Uuid
  anchor_key  String? @db.VarChar(60)

  article  wiki_articles @relation(fields: [article_id], references: [id])
  citation citations     @relation(fields: [citation_id], references: [id])

  @@unique([article_id, citation_id])
  @@map("wiki_article_citations")
}

model comments {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @db.Uuid
  entity_table      String   @db.VarChar(80)
  entity_id         String   @db.VarChar(64)
  parent_comment_id String?  @db.Uuid
  body_markdown     String
  is_hidden         Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  user           users      @relation(fields: [user_id], references: [id])
  parent_comment comments?  @relation("CommentTree", fields: [parent_comment_id], references: [id])
  replies        comments[] @relation("CommentTree")

  @@index([entity_table, entity_id])
  @@index([user_id])
  @@map("comments")
}

