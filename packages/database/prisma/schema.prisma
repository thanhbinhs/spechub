model catalog_drafts {
  id                String    @id @default(uuid()) @db.Uuid
  draft_type        String    @db.VarChar(40)
  entity_table      String?   @db.VarChar(80)
  entity_id         String?   @db.VarChar(64)
  owner_user_id     String    @db.Uuid
  title             String    @db.VarChar(200)
  step_key          String    @default("general") @db.VarChar(40)
  status            String    @default("draft") @db.VarChar(30)
  revision          Int       @default(1)
  payload           Json
  validation_errors Json?
  last_autosaved_at DateTime? @db.Timestamptz(6)
  published_at      DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  owner            users                      @relation(fields: [owner_user_id], references: [id], onDelete: Restrict)
  versions         catalog_draft_versions[]
  attribute_claims catalog_attribute_claims[]

  @@index([owner_user_id, status, updated_at])
  @@index([entity_table, entity_id])
  @@map("catalog_drafts")
}

/// A field-level assertion from a source. Claims are kept independently from
/// the normalized catalog value so that a published record remains auditable
/// when a source changes, a region differs, or sources disagree.
model catalog_attribute_claims {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalog_draft_id    String?   @db.Uuid
  entity_table        String?   @db.VarChar(80)
  entity_id           String?   @db.Uuid
  field_path          String    @db.VarChar(180)
  value_json          Json
  display_value       String?   @db.VarChar(1000)
  claim_kind          String    @db.VarChar(30) // declared, measured, benchmark, commercial, editorial
  source_id           String    @db.Uuid
  citation_id         String?   @db.Uuid
  scope_region        String?   @db.VarChar(20)
  scope_sku           String?   @db.VarChar(100)
  methodology         String?
  tested_at           DateTime? @db.Date
  retrieved_at        DateTime  @default(now()) @db.Timestamptz(6)
  evidence_excerpt    String?
  confidence          Decimal?  @db.Decimal(3, 2)
  status              String    @default("candidate") @db.VarChar(20) // candidate, accepted, conflict, rejected, stale
  resolution_note     String?   @db.VarChar(1000)
  created_by_user_id  String?   @db.Uuid
  reviewed_by_user_id String?   @db.Uuid
  reviewed_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)

  catalog_draft catalog_drafts? @relation(fields: [catalog_draft_id], references: [id], onDelete: Cascade)
  source        sources         @relation(fields: [source_id], references: [id], onDelete: Restrict)
  citation      citations?      @relation(fields: [citation_id], references: [id], onDelete: SetNull)
  created_by    users?          @relation("AttributeClaimCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  reviewed_by   users?          @relation("AttributeClaimReviewedBy", fields: [reviewed_by_user_id], references: [id], onDelete: SetNull)

  @@index([catalog_draft_id, field_path, status])
  @@index([entity_table, entity_id, field_path, status], map: "catalog_attribute_claims_entity_table_entity_id_field_path_stat")
  @@index([status, created_at])
  @@index([source_id, retrieved_at])
  @@map("catalog_attribute_claims")
}

model catalog_draft_versions {
  id               String   @id @default(uuid()) @db.Uuid
  catalog_draft_id String   @db.Uuid
  revision         Int
  actor_user_id    String?  @db.Uuid
  payload          Json
  change_summary   String?  @db.VarChar(300)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  catalog_draft catalog_drafts @relation(fields: [catalog_draft_id], references: [id], onDelete: Cascade)
  actor         users?         @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@unique([catalog_draft_id, revision])
  @@index([actor_user_id, created_at])
  @@map("catalog_draft_versions")
}

model catalog_entity_versions {
