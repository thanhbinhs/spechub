  raw_pages raw_pages[]

  @@map("data_sources")
}

model raw_pages {
  id              String    @id @default(uuid()) @db.Uuid
  source_id       String    @db.Uuid
  url             String    @unique
  raw_html        String?
  raw_text        String?
  parsed_data     Json?
  status          String    @default("pending") @db.VarChar(20)
  device_model_id String?   @db.Uuid
  error_message   String?
  attempts        Int       @default(0)
  crawled_at      DateTime  @default(now())
  parsed_at       DateTime?

  source       data_sources   @relation(fields: [source_id], references: [id])
  device_model device_models? @relation(fields: [device_model_id], references: [id])

  @@index([status])
  @@index([source_id])
  @@map("raw_pages")
}

// ============================================================
// L. COMMERCE & AFFILIATE
// ============================================================

model affiliate_partners {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique @db.VarChar(100)
  slug            String   @unique @db.VarChar(120)
  base_url        String
  logo_url        String?
  description     String?  @db.VarChar(300)
  commission_rate Decimal  @db.Decimal(5, 2)
  is_trusted      Boolean  @default(false)
  is_active       Boolean  @default(true)
  display_order   Int      @default(100)
  created_at      DateTime @default(now())

  affiliate_links affiliate_links[]

  @@index([is_active, is_trusted, display_order])
  @@map("affiliate_partners")
}

model affiliate_links {
  id                 String   @id @default(uuid()) @db.Uuid
  partner_id         String   @db.Uuid
  device_variant_id  String   @db.Uuid
  region_code        String   @db.VarChar(2)
  product_url        String
  current_price      Decimal? @db.Decimal(12, 2)
  original_price     Decimal? @db.Decimal(12, 2)
  discount_percent   Decimal? @db.Decimal(5, 2)
  currency_code      String   @db.VarChar(3)
  in_stock           Boolean  @default(true)
  product_title      String?  @db.VarChar(300)
  image_url          String?
  availability_label String?  @db.VarChar(80)
  last_sync_source   String?  @db.VarChar(30)
  sync_status        String   @default("pending") @db.VarChar(20)
  sync_error         String?  @db.VarChar(500)
  last_checked_at    DateTime @default(now())
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  partner        affiliate_partners        @relation(fields: [partner_id], references: [id])
  device_variant device_variants           @relation(fields: [device_variant_id], references: [id])
  price_history  affiliate_price_history[]
  clicks         affiliate_clicks[]

  @@index([device_variant_id, region_code])
  @@index([partner_id, sync_status, last_checked_at])
  @@map("affiliate_links")
}

model affiliate_price_history {
  id                String   @id @default(uuid()) @db.Uuid
  affiliate_link_id String   @db.Uuid
  price             Decimal  @db.Decimal(12, 2)
  currency_code     String   @db.VarChar(3)
  recorded_at       DateTime @default(now())

  affiliate_link affiliate_links @relation(fields: [affiliate_link_id], references: [id])

  @@index([affiliate_link_id, recorded_at])
  @@map("affiliate_price_history")
}

model affiliate_clicks {
  id                String   @id @default(uuid()) @db.Uuid
  affiliate_link_id String   @db.Uuid
  user_id           String?  @db.Uuid
  session_id        String?  @db.Uuid
  ip_address        String?  @db.Inet
  user_agent        String?
  referrer          String?
  clicked_at        DateTime @default(now())

  affiliate_link affiliate_links @relation(fields: [affiliate_link_id], references: [id])

  @@index([affiliate_link_id])
  @@index([clicked_at])
  @@map("affiliate_clicks")
}

// ============================================================
// M. SUBSCRIPTIONS
// ============================================================

model subscription_plans {
  id                      String   @id @default(uuid()) @db.Uuid
  code                    String   @unique @db.VarChar(30)
  name                    String   @db.VarChar(100)
  description             String?
  price_monthly           Decimal  @db.Decimal(8, 2)
  price_yearly            Decimal  @db.Decimal(8, 2)
  currency_code           String   @db.VarChar(3)
  stripe_price_monthly_id String?  @unique @db.VarChar(120)
  stripe_price_yearly_id  String?  @unique @db.VarChar(120)
  features                Json
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now())

  subscriptions subscriptions[]

  @@map("subscription_plans")
}

model subscriptions {
  id                   String    @id @default(uuid()) @db.Uuid
  user_id              String    @unique @db.Uuid
  plan_id              String    @db.Uuid
  provider             String    @default("manual") @db.VarChar(30)
  status               String    @default("active") @db.VarChar(30)
  billing_cycle        String    @db.VarChar(20)
  stripe_customer_id   String?   @unique
  stripe_sub_id        String?   @unique
  current_period_end   DateTime?
  cancel_at_period_end Boolean   @default(false)
  cancelled_at         DateTime?
  ended_at             DateTime?
  last_payment_at      DateTime?
  last_payment_error   String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user               users                @relation(fields: [user_id], references: [id])
  plan               subscription_plans   @relation(fields: [plan_id], references: [id])
  billing_audit_logs billing_audit_logs[]

  @@map("subscriptions")
}

model billing_audit_logs {
  id                String   @id @default(uuid()) @db.Uuid
  subscription_id   String?  @db.Uuid
  user_id           String?  @db.Uuid
  provider          String   @db.VarChar(30)
  action            String   @db.VarChar(80)
  status            String   @db.VarChar(30)
  external_event_id String?  @db.VarChar(120)
  details           Json?
  error_message     String?
  created_at        DateTime @default(now())

  subscription subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  user         users?         @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([subscription_id, created_at])
  @@index([external_event_id])
  @@map("billing_audit_logs")
}

model billing_webhook_events {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String    @db.VarChar(30)
  external_event_id String    @db.VarChar(120)
  event_type        String    @db.VarChar(100)
  payload_hash      String    @db.Char(64)
  status            String    @default("received") @db.VarChar(30)
  error_message     String?
  received_at       DateTime  @default(now())
  processed_at      DateTime?

  @@unique([provider, external_event_id])
  @@index([status, received_at])
  @@map("billing_webhook_events")
}

// ============================================================
// N. USER ENGAGEMENT
// ============================================================

model wishlists {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  name       String   @default("Default") @db.VarChar(100)
  is_public  Boolean  @default(false)
  created_at DateTime @default(now())

  user  users            @relation(fields: [user_id], references: [id])
  items wishlist_items[]

  @@map("wishlists")
}

model wishlist_items {
  id                String   @id @default(uuid()) @db.Uuid
  wishlist_id       String   @db.Uuid
  device_variant_id String   @db.Uuid
  notes             String?
  added_at          DateTime @default(now())

  wishlist       wishlists       @relation(fields: [wishlist_id], references: [id])
  device_variant device_variants @relation(fields: [device_variant_id], references: [id])

  @@unique([wishlist_id, device_variant_id])
  @@map("wishlist_items")
}

model price_alerts {
  id                String    @id @default(uuid()) @db.Uuid
  user_id           String    @db.Uuid
  device_variant_id String    @db.Uuid
  target_price      Decimal   @db.Decimal(12, 2)
  currency_code     String    @db.VarChar(3)
  region_code       String    @db.VarChar(2)
  is_active         Boolean   @default(true)
  triggered_at      DateTime?
  created_at        DateTime  @default(now())

  user           users           @relation(fields: [user_id], references: [id])
  device_variant device_variants @relation(fields: [device_variant_id], references: [id])

  @@index([device_variant_id, is_active])
  @@map("price_alerts")
}

model notifications {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(200)
  body       String?
  data       Json?
  read_at    DateTime?
  created_at DateTime  @default(now())

  user       users                     @relation(fields: [user_id], references: [id])
  deliveries notification_deliveries[]

  @@index([user_id, read_at])
  @@map("notifications")
}

model notification_deliveries {
  id                  String    @id @default(uuid()) @db.Uuid
  notification_id     String    @db.Uuid
  channel             String    @db.VarChar(20)
  recipient           String    @db.VarChar(320)
  status              String    @default("pending") @db.VarChar(20)
  attempts            Int       @default(0)
  provider_message_id String?   @db.VarChar(200)
  last_error          String?
  next_attempt_at     DateTime? @db.Timestamptz(6)
  sent_at             DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)

  notification notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, channel])
  @@index([status, next_attempt_at])
  @@map("notification_deliveries")
}

// ============================================================
// M. B2B API ACCESS
// ============================================================

model api_keys {
  id                    String    @id @default(uuid()) @db.Uuid
  user_id               String    @db.Uuid
  name                  String    @db.VarChar(100)
  key_prefix            String    @unique @db.VarChar(32)
  key_hash              String    @unique @db.Char(64)
  scopes                Json
  rate_limit_per_minute Int       @default(60)
  monthly_quota         Int?
  is_active             Boolean   @default(true)
  last_used_at          DateTime? @db.Timestamptz(6)
  expires_at            DateTime? @db.Timestamptz(6)
  revoked_at            DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @updatedAt @db.Timestamptz(6)

  user  users           @relation(fields: [user_id], references: [id])
  usage api_key_usage[]

  @@index([user_id, is_active])
  @@index([expires_at])
  @@map("api_keys")
}

model api_key_usage {
  id            String   @id @default(uuid()) @db.Uuid
  api_key_id    String   @db.Uuid
  bucket_start  DateTime @db.Timestamptz(6)
  request_count Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  api_key api_keys @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@unique([api_key_id, bucket_start])
  @@index([bucket_start])
  @@map("api_key_usage")
}
