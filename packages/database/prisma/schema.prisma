// ============================================================
// SpecHub Prisma Schema v2 — Production-ready
// ============================================================
// Đã được optimize từ DBML schema + thêm AI/Commerce/Engagement
// ============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
  binaryTargets   = ["native"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, unaccent]
}

// ============================================================
// 0. SHARED / META
// ============================================================

model languages {
  id         Int     @id @default(autoincrement())
  code       String  @unique @db.VarChar(10) // BCP-47: vi, en, en-US
  name       String  @db.VarChar(60)
  is_default Boolean @default(false)
  is_active  Boolean @default(true)

  translations  translations[]
  wiki_articles wiki_articles[]

  @@map("languages")
}

model translations {
  id           String @id @default(uuid()) @db.Uuid
  entity_table String @db.VarChar(80)
  entity_id    String @db.VarChar(64)
  field_key    String @db.VarChar(60)
  language_id  Int
  value_text   String

  language languages @relation(fields: [language_id], references: [id])

  @@unique([entity_table, entity_id, field_key, language_id])
  @@index([entity_table, entity_id])
  @@map("translations")
}

model release_statuses {
  id         Int    @id @default(autoincrement())
  code       String @unique @db.VarChar(30)
  name       String @db.VarChar(60)
  sort_order Int    @default(0)

  device_models   device_models[]
  device_variants device_variants[]

  @@map("release_statuses")
}

model currencies {
  id             Int     @id @default(autoincrement())
  code           String  @unique @db.VarChar(3) // ISO 4217: USD, VND
  name           String  @db.VarChar(60)
  symbol         String? @db.VarChar(8)
  decimal_digits Int     @default(2)

  device_variants       device_variants[]
  variant_price_history variant_price_history[]

  @@map("currencies")
}

model sources {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(160)
  slug        String   @unique @db.VarChar(180)
  source_type String   @db.VarChar(40) // official, review, certification...
  base_url    String?
  trust_level Int      @default(3) // 1=low, 5=highest
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  citations                 citations[]
  media_assets              media_assets[]
  variant_price_history     variant_price_history[]
  variant_certifications    variant_certifications[]
  device_variant_features   device_variant_features[]
  benchmark_runs            benchmark_runs[]
  device_variant_benchmarks device_variant_benchmarks[]
  chipset_benchmarks        chipset_benchmarks[]
  cpu_benchmarks            cpu_benchmarks[]
  gpu_benchmarks            gpu_benchmarks[]
  npu_benchmarks            npu_benchmarks[]
  attribute_claims          catalog_attribute_claims[]

  @@index([slug])
  @@index([source_type])
  @@map("sources")
}

model citations {
  id           String    @id @default(uuid()) @db.Uuid
  source_id    String    @db.Uuid
  url          String?
  title        String?   @db.VarChar(300)
  author       String?   @db.VarChar(200)
  published_at DateTime? @db.Date
  retrieved_at DateTime? @db.Date
  excerpt      String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  source                  sources                    @relation(fields: [source_id], references: [id])
  device_variant_features device_variant_features[]
  benchmark_runs          benchmark_runs[]
  wiki_article_citations  wiki_article_citations[]
  attribute_claims        catalog_attribute_claims[]

  @@index([source_id])
  @@index([published_at])
  @@map("citations")
}

model media_assets {
  id                String   @id @default(uuid()) @db.Uuid
  asset_type        String   @db.VarChar(30) // image, video, 3d_model
  url               String? // Legacy read-only fallback; new uploads use object_key
  cdn_url           String?
  storage_provider  String?  @db.VarChar(40)
  storage_bucket    String?  @db.VarChar(120)
  object_key        String?  @db.VarChar(1024)
  original_filename String?  @db.VarChar(255)
  upload_status     String   @default("ready") @db.VarChar(30)
  mime_type         String?  @db.VarChar(80)
  width_px          Int?
  height_px         Int?
  duration_ms       BigInt?
  file_size_bytes   BigInt?
  checksum_sha256   String?  @db.VarChar(64)
  alt_text          String?
  caption           String?
  copyright_holder  String?  @db.VarChar(200)
  license           String?  @db.VarChar(80)
  source_id         String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  source       sources?       @relation(fields: [source_id], references: [id])
  entity_media entity_media[]

  @@unique([storage_provider, storage_bucket, object_key])
  @@index([asset_type])
  @@index([source_id])
  @@index([upload_status])
  @@map("media_assets")
}

model entity_media {
  id             String  @id @default(uuid()) @db.Uuid
  entity_table   String  @db.VarChar(80)
  entity_id      String  @db.VarChar(64)
  media_asset_id String  @db.Uuid
  role           String  @db.VarChar(40) // hero, gallery, render_front
  display_order  Int     @default(0)
  is_primary     Boolean @default(false)

  media_asset media_assets @relation(fields: [media_asset_id], references: [id])

  @@index([entity_table, entity_id, role, display_order])
  @@index([media_asset_id])
  @@map("entity_media")
}

model module_field_coverage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_kind String   @db.VarChar(40)
  module_id   String   @db.Uuid
  field_key   String   @db.VarChar(100)
  status      String   @db.VarChar(30) // populated, derived, not_disclosed, not_applicable
  source_url  String?
  notes       String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([module_kind, module_id, field_key])
  @@index([module_kind, module_id])
  @@index([status])
  @@map("module_field_coverage")
}

model tags {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(80)
  slug        String  @unique @db.VarChar(100)
  tag_group   String? @db.VarChar(40) // feature, audience, era
  description String?

  entity_tags entity_tags[]

  @@map("tags")
}

model entity_tags {
  id           String @id @default(uuid()) @db.Uuid
  entity_table String @db.VarChar(80)
  entity_id    String @db.VarChar(64)
  tag_id       String @db.Uuid

  tag tags @relation(fields: [tag_id], references: [id])

  @@unique([entity_table, entity_id, tag_id])
  @@index([tag_id])
  @@map("entity_tags")
}

model units {
  id                String   @id @default(uuid()) @db.Uuid
  symbol            String   @unique @db.VarChar(20)
  name              String   @db.VarChar(60)
  quantity_type     String   @db.VarChar(40) // length, mass, time
  base_unit_id      String?  @db.Uuid
  conversion_factor Decimal? @db.Decimal(20, 10)

  base_unit units?  @relation("UnitHierarchy", fields: [base_unit_id], references: [id])
  derived   units[] @relation("UnitHierarchy")

  feature_definitions feature_definitions[]
  benchmarks          benchmarks[]

  @@map("units")
}

// ============================================================
// A. ORGANIZATION LAYER
// ============================================================

model organizations {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique @db.VarChar(160)
  slug          String    @unique @db.VarChar(180)
  short_name    String?   @db.VarChar(80)
  legal_name    String?   @db.VarChar(200)
  country_code  String?   @db.VarChar(2)
  founded_year  Int?
  website_url   String?
  logo_url      String?
  parent_org_id String?   @db.Uuid
  description   String
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  parent_org organizations?  @relation("OrgHierarchy", fields: [parent_org_id], references: [id])
  child_orgs organizations[] @relation("OrgHierarchy")

  organization_role_assignments organization_role_assignments[]
  product_families              product_families[]
  technology_families           technology_families[]
  architectures                 architectures[]
  process_nodes                 process_nodes[]
  chipsets                      chipsets[]
  cpus                          cpus[]
  gpus                          gpus[]
  npus                          npus[]
  modems                        modems[]
  camera_sensors                camera_sensors[]
  camera_modules                camera_modules[]
  display_units                 display_units[]
  battery_units                 battery_units[]
  memory_standards              memory_standards[]
  storage_standards             storage_standards[]
  operating_systems             operating_systems[]
  os_ui_layers                  os_ui_layers[]
  certifications                certifications[]
  software_features             software_features[]
  benchmarks                    benchmarks[]

  @@index([slug])
  @@index([country_code])
  @@index([parent_org_id])
  @@map("organizations")
}

model organization_roles {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(50)
  name String @unique @db.VarChar(100)

  assignments organization_role_assignments[]

  @@map("organization_roles")
}

model organization_role_assignments {
  id              String   @id @default(uuid()) @db.Uuid
  organization_id String   @db.Uuid
  role_id         Int
  start_year      Int?
  end_year        Int?
  notes           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  organization organizations      @relation(fields: [organization_id], references: [id])
  role         organization_roles @relation(fields: [role_id], references: [id])

  @@unique([organization_id, role_id])
  @@map("organization_role_assignments")
}

// ============================================================
// B. DEVICE HIERARCHY
// ============================================================

model device_categories {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @unique @db.VarChar(60)
  slug               String    @unique @db.VarChar(80)
  parent_category_id String?   @db.Uuid
  description        String?
  icon_url           String?
  display_order      Int       @default(0)
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  parent_category     device_categories?    @relation("CategoryTree", fields: [parent_category_id], references: [id])
  child_categories    device_categories[]   @relation("CategoryTree")
  product_families    product_families[]
  feature_definitions feature_definitions[]
  scoring_profiles    scoring_profiles[]

  @@index([slug])
  @@index([parent_category_id])
  @@map("device_categories")
}

model regions {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(20) // global, us, eu, vn
  name        String  @unique @db.VarChar(120)
  description String?

  variant_price_history       variant_price_history[]
  variant_region_availability variant_region_availability[]

  @@map("regions")
}

model product_families {
  id                 String    @id @default(uuid()) @db.Uuid
  brand_org_id       String    @db.Uuid
  device_category_id String    @db.Uuid
  name               String    @db.VarChar(120)
  slug               String    @unique @db.VarChar(160)
  description        String
  cover_image_url    String?
  first_release_year Int?
  last_release_year  Int?
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  brand_org       organizations     @relation(fields: [brand_org_id], references: [id])
  device_category device_categories @relation(fields: [device_category_id], references: [id])
  device_models   device_models[]

  @@unique([brand_org_id, name])
  @@index([slug])
  @@index([device_category_id])
  @@map("product_families")
}

model device_models {
  id                  String    @id @default(uuid()) @db.Uuid
  product_family_id   String    @db.Uuid
  name                String    @db.VarChar(160)
  slug                String    @unique @db.VarChar(200)
  internal_codename   String?   @db.VarChar(80)
  release_status_id   Int
  announcement_date   DateTime? @db.Date
  release_date        DateTime? @db.Date
  end_of_sale_date    DateTime? @db.Date
  end_of_support_date DateTime? @db.Date
  generation_label    String?   @db.VarChar(40)
  summary             String    @db.VarChar(600)
  description         String
  cover_image_url     String?
  view_count          BigInt    @default(0)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime? @db.Timestamptz(6)

  product_family product_families @relation(fields: [product_family_id], references: [id])
  release_status release_statuses @relation(fields: [release_status_id], references: [id])

  device_variants     device_variants[]
  predecessor_lineage model_lineage[]             @relation("Predecessor")
  successor_lineage   model_lineage[]             @relation("Successor")
  similarity_a        model_similarity[]          @relation("ModelA")
  similarity_b        model_similarity[]          @relation("ModelB")
  raw_pages           raw_pages[]
  aliases             device_model_aliases[]
  editorial_sections  device_editorial_sections[]

  @@unique([product_family_id, name])
  @@index([slug])
  @@index([release_date])
  @@index([announcement_date])
  @@map("device_models")
}

model device_variants {
  id                String    @id @default(uuid()) @db.Uuid
  device_model_id   String    @db.Uuid
  variant_name      String    @db.VarChar(160)
  sku_code          String?   @db.VarChar(100)
  market_name       String?   @db.VarChar(160)
  color_name        String?   @db.VarChar(80)
  color_hex         String?   @db.VarChar(7)
  release_status_id Int
  launch_date       DateTime? @db.Date
  end_of_sale_date  DateTime? @db.Date
  launch_price      Decimal?  @db.Decimal(12, 2)
  currency_id       Int?
  is_default        Boolean   @default(false)
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)

  device_model   device_models    @relation(fields: [device_model_id], references: [id])
  release_status release_statuses @relation(fields: [release_status_id], references: [id])
  currency       currencies?      @relation(fields: [currency_id], references: [id])

  variant_physical_specs        variant_physical_specs?
  variant_io_specs              variant_io_specs?
  variant_thermal_specs         variant_thermal_specs?
  variant_price_history         variant_price_history[]
  variant_chipsets              variant_chipsets[]
  variant_cpus                  variant_cpus[]
  variant_gpus                  variant_gpus[]
  variant_npus                  variant_npus[]
  variant_modems                variant_modems[]
  variant_displays              variant_displays[]
  variant_batteries             variant_batteries[]
  variant_camera_systems        variant_camera_systems[]
  variant_camera_modules        variant_camera_modules[]
  variant_memory_configs        variant_memory_configs[]
  variant_storage_configs       variant_storage_configs[]
  variant_wifi_bands            variant_wifi_bands[]
  variant_operating_systems     variant_operating_systems[]
  variant_cellular_band_support variant_cellular_band_support[]
  variant_certifications        variant_certifications[]
  variant_region_availability   variant_region_availability[]
  variant_software_features     variant_software_features[]
  device_variant_features       device_variant_features[]
  device_variant_benchmarks     device_variant_benchmarks[]
  variant_module_scores         variant_module_scores[]
  variant_score_metric_inputs   variant_score_metric_inputs[]
  variant_scorecards            variant_scorecards[]
  software_profile              variant_software_profiles?
  connectivity_support          variant_connectivity_support[]
  affiliate_links               affiliate_links[]
  wishlist_items                wishlist_items[]
  price_alerts                  price_alerts[]

  @@unique([device_model_id, variant_name])
  @@index([sku_code])
  @@index([launch_date])
  @@map("device_variants")
}

model device_model_aliases {
  id               String   @id @default(uuid()) @db.Uuid
  device_model_id  String   @db.Uuid
  alias            String   @db.VarChar(180)
  alias_type       String   @default("alias") @db.VarChar(30)
  normalized_alias String   @db.VarChar(180)
  region_code      String   @default("") @db.VarChar(20)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  device_model device_models @relation(fields: [device_model_id], references: [id], onDelete: Cascade)

  @@unique([device_model_id, normalized_alias, region_code])
  @@index([normalized_alias])
  @@map("device_model_aliases")
}

model device_editorial_sections {
  id              String   @id @default(uuid()) @db.Uuid
  device_model_id String   @db.Uuid
  section_key     String   @db.VarChar(40)
  title           String   @db.VarChar(160)
  body_markdown   String
  display_order   Int      @default(0)
  is_published    Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  device_model device_models @relation(fields: [device_model_id], references: [id], onDelete: Cascade)

  @@unique([device_model_id, section_key])
  @@index([device_model_id, is_published, display_order])
  @@map("device_editorial_sections")
}

model variant_price_history {
  id                String   @id @default(uuid()) @db.Uuid
  device_variant_id String   @db.Uuid
  region_id         String?  @db.Uuid
  price_type        String   @db.VarChar(30) // msrp, street, discount
  price             Decimal  @db.Decimal(12, 2)
  currency_id       Int
  effective_date    DateTime @db.Date
  source_id         String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  device_variant device_variants @relation(fields: [device_variant_id], references: [id])
  region         regions?        @relation(fields: [region_id], references: [id])
  currency       currencies      @relation(fields: [currency_id], references: [id])
  source         sources?        @relation(fields: [source_id], references: [id])

  @@index([device_variant_id, region_id, price_type, effective_date])
  @@index([effective_date])
  @@map("variant_price_history")
}

model variant_physical_specs {
  device_variant_id  String   @id @db.Uuid
  height_mm          Decimal? @db.Decimal(7, 2)
  width_mm           Decimal? @db.Decimal(7, 2)
  thickness_mm       Decimal? @db.Decimal(7, 2)
  thickness_min_mm   Decimal? @db.Decimal(7, 2)
  thickness_max_mm   Decimal? @db.Decimal(7, 2)
  weight_g           Decimal? @db.Decimal(7, 2)
  volume_cm3         Decimal? @db.Decimal(8, 2)
  frame_material     String?  @db.VarChar(120)
  back_material      String?  @db.VarChar(120)
  front_glass        String?  @db.VarChar(120)
  ingress_protection String?  @db.VarChar(40)
  notes              String?

  device_variant device_variants @relation(fields: [device_variant_id], references: [id])

  @@map("variant_physical_specs")
}

model variant_io_specs {
  device_variant_id       String   @id @db.Uuid
  sim_slots               Int?
  sim_type                String?  @db.VarChar(40)
  esim_supported          Boolean?
  esim_count              Int?
  stereo_speakers         Boolean?
  speaker_count           Int?
  audio_brand_tuning      String?  @db.VarChar(80)
  headphone_jack          Boolean?
  headphone_jack_size_mm  Decimal? @db.Decimal(3, 1)
  has_microsd_slot        Boolean?
  microsd_max_capacity_gb Int?
  has_ir_blaster          Boolean?
  has_notification_led    Boolean?
  notes                   String?

  device_variant device_variants @relation(fields: [device_variant_id], references: [id])

  @@map("variant_io_specs")
}

model variant_thermal_specs {
  device_variant_id  String   @id @db.Uuid
  cooling_type       String?  @db.VarChar(80) // vapor_chamber, graphite
  vc_area_mm2        Int?
  has_active_cooling Boolean?
  notes              String?

  device_variant device_variants @relation(fields: [device_variant_id], references: [id])

  @@map("variant_thermal_specs")
}

model model_lineage {
  id                   String  @id @default(uuid()) @db.Uuid
  predecessor_model_id String  @db.Uuid
  successor_model_id   String  @db.Uuid
  relation_type        String  @default("successor") @db.VarChar(30)
  relation_note        String?

  predecessor device_models @relation("Predecessor", fields: [predecessor_model_id], references: [id])
  successor   device_models @relation("Successor", fields: [successor_model_id], references: [id])

  @@unique([predecessor_model_id, successor_model_id, relation_type])
  @@map("model_lineage")
}

model model_similarity {
  id                   String    @id @default(uuid()) @db.Uuid
  model_a_id           String    @db.Uuid
  model_b_id           String    @db.Uuid
  similarity_score     Decimal   @db.Decimal(5, 2)
  chipset_score        Decimal?  @db.Decimal(5, 2)
  camera_score         Decimal?  @db.Decimal(5, 2)
  display_score        Decimal?  @db.Decimal(5, 2)
  battery_score        Decimal?  @db.Decimal(5, 2)
  memory_storage_score Decimal?  @db.Decimal(5, 2)
  design_score         Decimal?  @db.Decimal(5, 2)
  software_score       Decimal?  @db.Decimal(5, 2)
  reason               String?
  computed_at          DateTime?

  model_a device_models @relation("ModelA", fields: [model_a_id], references: [id])
  model_b device_models @relation("ModelB", fields: [model_b_id], references: [id])

  @@unique([model_a_id, model_b_id])
  @@index([similarity_score])
  @@map("model_similarity")
}

// ============================================================
// C. TAXONOMY / STANDARDS
// ============================================================

model technology_families {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique @db.VarChar(120)
  slug             String   @unique @db.VarChar(140)
  family_type      String   @db.VarChar(50)
  parent_family_id String?  @db.Uuid
  vendor_org_id    String?  @db.Uuid
  description      String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  parent_family  technology_families?  @relation("FamilyTree", fields: [parent_family_id], references: [id])
  child_families technology_families[] @relation("FamilyTree")
  vendor         organizations?        @relation(fields: [vendor_org_id], references: [id])

  chipsets          chipsets[]
  cpus              cpus[]
  gpus              gpus[]
  npus              npus[]
  modems            modems[]
  camera_sensors    camera_sensors[]
  memory_standards  memory_standards[]
  storage_standards storage_standards[]

  @@index([slug])
  @@index([family_type])
  @@map("technology_families")
}

model architectures {
  id                String  @id @default(uuid()) @db.Uuid
  name              String  @unique @db.VarChar(120)
  slug              String  @unique @db.VarChar(140)
  architecture_type String  @db.VarChar(40)
  vendor_org_id     String? @db.Uuid
  release_year      Int?
  description       String?

  vendor organizations? @relation(fields: [vendor_org_id], references: [id])

  cpus cpus[]
  gpus gpus[]
  npus npus[]

  @@index([slug])
  @@index([architecture_type])
