{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "FRONTEND_URL",
    "ADMIN_URL",
    "NEXT_PUBLIC_SPECHUB_API_URL",
    "NEXT_PUBLIC_WEB_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "JWT_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "MEILI_ENABLED",
    "MEILI_HOST",
    "MEILI_API_KEY",
    "MEILI_DEVICE_MODELS_INDEX",
    "AI_PROVIDER",
    "AI_CHAT_BASE_URL",
    "AI_EMBEDDING_PROVIDER",
    "AI_OPENAI_MODEL",
    "AI_OPENAI_EMBEDDING_MODEL",
    "AI_ANTHROPIC_MODEL",
    "AI_TEMPERATURE",
    "AI_MAX_TOKENS",
    "AI_EMBEDDING_DIMENSIONS",
    "AI_REQUEST_TIMEOUT_MS",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "PRICE_ALERTS_SCHEDULE_ENABLED",
    "PRICE_ALERTS_WORKER_ENABLED",
    "PRICE_ALERTS_INTERVAL_MINUTES",
    "AFFILIATE_PRICE_SYNC_ENABLED",
    "AFFILIATE_PRICE_SYNC_MAX_AGE_MINUTES",
    "AFFILIATE_PRICE_SYNC_BATCH_SIZE",
    "AFFILIATE_PRICE_SYNC_CONCURRENCY",
    "CRAWLER_WORKER_ENABLED",
    "CRAWLER_INTERVAL_MINUTES",
    "CRAWLER_ALLOW_HTTP",
    "EMAIL_DELIVERY_ENABLED",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "NOTIFICATION_EMAIL_INTERVAL_MINUTES",
    "NOTIFICATION_EMAIL_BATCH_SIZE",
    "NOTIFICATION_EMAIL_MAX_ATTEMPTS",
    "NOTIFICATION_EMAIL_MAX_AGE_HOURS",
    "LOG_FORMAT",
    "METRICS_TOKEN",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_WEBHOOK_TOLERANCE_SECONDS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "^db:generate"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": ["**/generated/**"]
    },
    "db:validate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
