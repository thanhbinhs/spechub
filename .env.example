# === DATABASE ===
DATABASE_URL="postgresql://spechub:spechub123@localhost:5432/spechub_dev"
DATABASE_TEST_URL="postgresql://spechub:spechub123@localhost:5432/spechub_test"

# === REDIS ===
REDIS_URL="redis://localhost:6379"

# === SEARCH ===
MEILI_HOST="http://localhost:7700"
MEILI_API_KEY=""
MEILI_ENABLED="false"
MEILI_DEVICE_MODELS_INDEX="device_models"

# === AI/LLM ===
AI_PROVIDER="local"
# Set AI_PROVIDER="ollama" and use http://127.0.0.1:11434/v1 for Ollama.
AI_CHAT_BASE_URL="https://api.openai.com/v1"
AI_EMBEDDING_PROVIDER="local"
AI_OPENAI_MODEL="gpt-4o-mini"
AI_OLLAMA_MODEL="qwen2.5:3b"
AI_OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
AI_ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
AI_TEMPERATURE="0.2"
AI_MAX_TOKENS="1200"
AI_EMBEDDING_DIMENSIONS="1536"
AI_REQUEST_TIMEOUT_MS="30000"
AI_STREAM_IDLE_TIMEOUT_MS="45000"
# Ollama may need longer for the first response while loading a model.
AI_OLLAMA_REQUEST_TIMEOUT_MS="120000"
AI_OLLAMA_STREAM_IDLE_TIMEOUT_MS="120000"
AI_OLLAMA_KEEP_ALIVE="10m"
AI_OLLAMA_CONTEXT_LENGTH="16384"
# Enable only when you accept a slower second verification generation.
AI_OLLAMA_VERIFY_REASONING="false"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
VOYAGE_API_KEY=""

# === STORAGE ===
# Catalog Studio uses a short-lived signed PUT URL. When the S3 endpoint and
# credentials are blank in development, files are saved to local storage.
STORAGE_PROVIDER="s3-compatible"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION="auto"
STORAGE_S3_BUCKET="spechub-dev"
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_CDN_BASE_URL=""
NEXT_PUBLIC_STORAGE_CDN_BASE_URL=""
# Optional local-storage overrides. Defaults:
# root=.local-storage, API base=http://localhost:4000/api/v1,
# public URL=http://localhost:4000/media.
STORAGE_LOCAL_ROOT=""
STORAGE_LOCAL_API_BASE_URL=""
STORAGE_LOCAL_PUBLIC_URL=""
STORAGE_LOCAL_SIGNING_SECRET=""

# Deprecated aliases kept temporarily for older integrations.
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="spechub-dev"
S3_REGION="auto"
S3_ENDPOINT=""

# === EMAIL ===
RESEND_API_KEY=""
EMAIL_FROM="noreply@spechub.io"
# Explicitly opt in to outbound delivery. Notifications remain in-app when false.
EMAIL_DELIVERY_ENABLED="false"
NOTIFICATION_EMAIL_INTERVAL_MINUTES="5"
NOTIFICATION_EMAIL_BATCH_SIZE="25"
NOTIFICATION_EMAIL_MAX_ATTEMPTS="5"
NOTIFICATION_EMAIL_MAX_AGE_HOURS="24"

# === PAYMENTS ===
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_WEBHOOK_TOLERANCE_SECONDS="300"

# === WORKERS / SCHEDULES ===
# Deprecated local fallback. Keep false when the separate worker is running.
PRICE_ALERTS_SCHEDULE_ENABLED="false"
PRICE_ALERTS_WORKER_ENABLED="false"
PRICE_ALERTS_INTERVAL_MINUTES="60"
# Tự đọc lại giá các liên kết đã cũ. Lịch chạy kiểm tra mỗi 30 phút và
# chỉ xử lý liên kết chưa được cập nhật trong khoảng thời gian bên dưới.
AFFILIATE_PRICE_SYNC_ENABLED="true"
AFFILIATE_PRICE_SYNC_MAX_AGE_MINUTES="180"
AFFILIATE_PRICE_SYNC_BATCH_SIZE="24"
AFFILIATE_PRICE_SYNC_CONCURRENCY="4"
# Optional server-side bridge to official marketplace/affiliate APIs. It receives
# { partner, product_url, market } and returns { price, currency, in_stock }.
# Without it, SpecHub reads schema.org Product/Offer metadata from saved links.
COMMERCE_PRICE_API_URL=""
COMMERCE_PRICE_API_TOKEN=""
# The crawler only requests HTTPS pages on the source's own origin and allowed paths.
CRAWLER_WORKER_ENABLED="false"
CRAWLER_INTERVAL_MINUTES="360"
CRAWLER_ALLOW_HTTP="false"

# === AUTH ===
AUTH_SECRET="generate-with-openssl-rand-base64-32"
JWT_SECRET="generate-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# === MONITORING ===
SENTRY_DSN=""
POSTHOG_KEY=""
LOG_FORMAT="pretty"
# Leave empty to disable /api/v1/health/metrics. If set, call it with Bearer token auth.
METRICS_TOKEN=""

# === URLs ===
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_SPECHUB_API_URL="http://localhost:4000/api/v1"
# Next.js dùng địa chỉ này khi tải dữ liệu phía máy chủ.
SPECHUB_API_INTERNAL_URL="http://127.0.0.1:4000/api/v1"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
